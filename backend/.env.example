DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/hospital_sarcobamba
JWT_SECRET_KEY=cambiar-este-valor-en-produccion
DEBUG=true
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=.models/whisper
WHISPER_CPU_THREADS=4
# 1 prioriza velocidad; 5 conserva la búsqueda predeterminada. Revisar siempre el texto.
WHISPER_BEAM_SIZE=5
CLINICAL_EXTRACTOR_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
CLINICAL_EXTRACTOR_TIMEOUT_SECONDS=180
## Asistencia radiológica experimental (optativa, solo pesos/corpus locales)
RADIOLOGY_AI_ENABLED=false
RADIOLOGY_STORAGE_DIR=.storage/radiologia
RADIOLOGY_VISION_MIN_FREE_MIB=4096
RADIOLOGY_SCORE_THRESHOLD=0.5
