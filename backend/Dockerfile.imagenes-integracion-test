# Solo verificación del módulo real y auth; no incorpora Whisper ni instala otro modelo.
FROM sarcosistema-rag-offline:fase3
USER root
RUN pip install --no-cache-dir fastapi==0.115.0 pydantic==2.9.2 pydantic-settings==2.5.2 \
    pyjwt==2.9.0 argon2-cffi==23.1.0 httpx==0.27.2 python-multipart==0.0.9
COPY app/imagenes ./app/imagenes
COPY app/accesos ./app/accesos
COPY app/config ./app/config
COPY app/shared ./app/shared
COPY scripts/verificar_imagenes_offline.py ./scripts/verificar_imagenes_offline.py
USER 10001:10001
CMD ["python", "-m", "scripts.verificar_imagenes_offline"]
